QWidget { font-family: Inter, "Sans Serif"; font-size: 13px; color: #e9ebf2; }
QMainWindow, QDialog, QWidget#centralwidget { background: #191b21; }
QLabel { background: transparent; }
#sidebarApp { background: #242730; color: #cdd2df; border: none; }
QPushButton, QToolButton { background: #303540; color: #f0f2f7; border: 1px solid #444b5a; border-radius: 11px; padding: 8px 16px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #414b5d; border-color: #7183a5; }
QPushButton:pressed, QToolButton:pressed { background: #242b39; }
QPushButton:default { background: #a3b9f5; color: #17233b; border-color: #a3b9f5; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { background: #252932; color: #777e8c; border-color: #353a44; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit { background: #242832; color: #edf0f7; border: 1px solid #414857; border-radius: 9px; padding: 7px; selection-background-color: #a3b9f5; selection-color: #17233b; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #9aaff3; }
QAbstractItemView { background: #222630; alternate-background-color: #282d37; color: #edf0f7; border: 1px solid #383e4a; border-radius: 9px; selection-background-color: #43567b; selection-color: white; }
QHeaderView::section { background: #303541; color: #dce1ed; padding: 7px; border: none; }
QGroupBox { border: 1px solid #383f4d; border-radius: 12px; margin-top: 14px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
QProgressBar { background: #303642; border: none; border-radius: 7px; min-height: 14px; text-align: center; color: #f2f4fa; }
QProgressBar::chunk { background: #a3b9f5; border-radius: 7px; }
QCheckBox, QRadioButton { spacing: 8px; padding: 4px; }
QScrollBar:vertical { background: transparent; width: 12px; }
QScrollBar::handle:vertical { background: #626b7d; border-radius: 5px; min-height: 24px; }
QMenu { background: #292e38; border: 1px solid #444b5a; padding: 6px; }
QMenu::item:selected { background: #43567b; }
